import cls from "./groupHeader.module.sass"
import {Button} from "shared/ui/button";
import React, {FC, useEffect} from "react";
import {Select} from "shared/ui/select";
import {useSelector} from "react-redux";
import {
    getFilterRadioItem,
} from "entities/group/model/selector/groupFilterSelector";
import {FilterRadioItem} from "entities/group/model/type/groupFilterTypes";
import {headers, useHttp} from "shared/api/base";
import {useAppDispatch} from "shared/lib/hooks/useAppDispatch/useAppDispatch";
import {groupListActions} from "entities/group";




interface IGroupHeaderProps {

    setActiveCheck: (arg: any) => void
    filterRadioItem: FilterRadioItem[] | undefined,
    activeItem: string[] | number[]
}


export const GroupHeader: FC<IGroupHeaderProps> = ({setActiveCheck , filterRadioItem ,  activeItem}) => {



    const {request} = useHttp()

    const dispatch = useAppDispatch()

    const onClickData= () => {

        for (let i = 0; i < activeItem.length; i++) {

            request({
                url: `analysis/laboratory/update/${activeItem[i]}/`,
                method: "PUT",
                body: JSON.stringify({analysis: activeItem[i]}),
                headers: headers()
            })
                .then(res => {
                    console.log(res)
                    dispatch(groupListActions.onUpdateList({id: activeItem[i] , data: res}))
                })
        }


    }


    return (
        <>
            <div className={cls.header}>
                <div className={cls.header__title}>
                    Группы
                </div>
                <div className={cls.header__buttons}>
                    <Select setSelectOption={setActiveCheck} optionsData={filterRadioItem}/>
                    <Button onClick={onClickData}> <i className={"fa fa-check"}/> Проверено </Button>
                </div>
            </div>


        </>
    );
};

